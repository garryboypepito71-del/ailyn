# Required workspace authentication
AILYN_LOGIN_PASSWORD=replace-with-a-long-random-password

# Required for restore and signed updates
AILYN_ADMIN_PASSWORD=replace-with-a-separate-admin-password
AILYN_UPDATE_SIGNING_KEY=replace-with-a-long-random-signing-key

# IANA timezone used for dashboard clocks and new records
AILYN_TIMEZONE=Asia/Manila

# Keep core UI styling local and avoid remote background assets
AILYN_OFFLINE_MODE=1

# Optional persistent location outside the repository
# AILYN_DATA_DIR=/srv/ailyn-data

# Optional outbound email configuration
# AILYN_SENDER_EMAIL=
# AILYN_SENDER_PASSWORD=
